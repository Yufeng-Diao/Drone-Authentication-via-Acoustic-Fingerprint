# Copy outside the checkout, edit absolute paths, then use --env-file.
# No credentials belong here. Export LOCAL_UID=$(id -u) LOCAL_GID=$(id -g).
# Replace with the published Docker Hub tag or digest when available.
DRONE_IMAGE=drone-auth:local
AUDIO_DIR=/absolute/path/to/extracted
RUNS_DIR=/absolute/path/to/artifacts/runs
CACHE_DIR=/absolute/path/to/artifacts/cache
LOGS_DIR=/absolute/path/to/evidence/logs
FIGURES_DIR=/absolute/path/to/evidence/figures
PAPER_DIR=/absolute/path/to/papers
COMPARISONS_DIR=/absolute/path/to/evidence/comparisons
# Start with the eight-model validation subset, then choose paper/full_sweep.json.
PAPER_CONFIG=/opt/drone/config/validation/paper_smoke.json
RUN_NAME=paper-smoke-001
GALLERY_NAME=paper-smoke-001
COMPARISON_NAME=paper-comparison-001
MONITOR_PORT=8765
